rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && currentUser().status == "approved";
    }

    function isSuperAdmin() {
      return isApproved() && currentUser().role == "super_admin";
    }

    function isAdmin() {
      return isApproved()
        && (currentUser().role == "super_admin" || currentUser().role == "admin");
    }

    function canReadBingo() {
      return isApproved()
        && (isAdmin() || currentUser().bingoAccess == "read" || currentUser().bingoAccess == "write");
    }

    function canWriteBingo() {
      return isApproved()
        && (isAdmin() || currentUser().bingoAccess == "write");
    }

    function canReadKillSheet() {
      return isApproved()
        && (isAdmin() || currentUser().killSheetAccess == "read" || currentUser().killSheetAccess == "write");
    }

    function canWriteKillSheet() {
      return isApproved()
        && (isAdmin() || currentUser().killSheetAccess == "write");
    }

    function membershipPath(userId) {
      return /databases/$(database)/documents/bingoMemberships/$(userId);
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/bingoRooms/$(roomId);
    }

    function boardPath(roomId) {
      return /databases/$(database)/documents/bingoBoards/$(roomId);
    }

    function activeInRoom(roomId) {
      return signedIn()
        && exists(membershipPath(request.auth.uid))
        && get(membershipPath(request.auth.uid)).data.roomId == roomId;
    }

    function canSeeRoom(roomData) {
      return signedIn()
        && (roomData.ownerUid == request.auth.uid
          || request.auth.uid in roomData.participantUids);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name", "email", "role", "status", "bingoAccess", "killSheetAccess", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user"
        && request.resource.data.status == "pending"
        && request.resource.data.bingoAccess == "none"
        && request.resource.data.killSheetAccess == "none"
        && request.resource.data.createdAt == request.time;

      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());

      // 방 생성 시 참가자를 고를 수 있도록 빙고 쓰기 권한자에게만 사용자 목록을 허용합니다.
      allow list: if isAdmin() || canWriteBingo();

      allow update: if isSuperAdmin()
        && resource.data.role != "super_admin"
        && request.resource.data.role != "super_admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role", "status", "bingoAccess", "killSheetAccess"
        ]);

      allow update: if isAdmin()
        && !isSuperAdmin()
        && resource.data.role == "user"
        && request.resource.data.role == "user"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "bingoAccess", "killSheetAccess"
        ]);

      // 관리자는 일반 사용자의 서비스 프로필을 삭제할 수 있습니다.
      // Firebase Authentication의 Google 계정 자체를 삭제하는 규칙은 아닙니다.
      allow delete: if isAdmin()
        && resource.data.role == "user"
        && request.auth.uid != userId;
    }

    match /bingoMemberships/{userId} {
      // 자신의 현재 참가 상태는 자신만 직접 읽을 수 있습니다.
      // 방장은 자신의 방에 실제 참가 중인 사용자의 참가 상태를 확인할 수 있습니다.
      allow get: if signedIn() && (
        isAdmin()
        || request.auth.uid == userId
        // 방장은 자신의 현재 방에 초대한 사용자의 참가 상태를 확인할 수 있습니다.
        // 아직 참가하지 않아 membership 문서가 없는 사용자도 안전하게 조회할 수 있게 합니다.
        || (
          exists(membershipPath(request.auth.uid))
          && get(membershipPath(request.auth.uid)).data.role == "owner"
          && get(membershipPath(request.auth.uid)).data.roomId is string
          && exists(roomPath(get(membershipPath(request.auth.uid)).data.roomId))
          && get(roomPath(get(membershipPath(request.auth.uid)).data.roomId)).data.ownerUid == request.auth.uid
          && userId in get(roomPath(get(membershipPath(request.auth.uid)).data.roomId)).data.participantUids
        )
        || (
          resource.data.roomId is string
          && exists(roomPath(resource.data.roomId))
          && get(roomPath(resource.data.roomId)).data.ownerUid == request.auth.uid
        )
      );
      allow list: if false;

      // 문서 ID가 UID이므로 사용자당 활성 참가 문서는 최대 1개입니다.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["roomId", "role", "joinedAt"])
        && request.resource.data.roomId is string
        && request.resource.data.role in ["owner", "participant"]
        && request.resource.data.joinedAt == request.time
        && (
          (
            request.resource.data.role == "owner"
            && canWriteBingo()
          )
          || (
            request.resource.data.role == "participant"
            && canReadBingo()
            && exists(roomPath(request.resource.data.roomId))
            && request.auth.uid in get(roomPath(request.resource.data.roomId)).data.participantUids
          )
        );

      allow update: if false;

      allow delete: if isAdmin() || (signedIn() && (
        // 일반 참가자는 자신의 참가 상태를 지워 방을 나갈 수 있습니다.
        (
          request.auth.uid == userId
          && resource.data.role == "participant"
        )
        // 방장은 자신의 방 문서를 먼저 삭제한 뒤 자신의 참가 상태를 지울 수 있습니다.
        || (
          request.auth.uid == userId
          && resource.data.role == "owner"
          && !exists(roomPath(resource.data.roomId))
        )
        // 방장은 자신의 방 참가자를 강제로 퇴장시킬 수 있습니다.
        || (
          isApproved()
          && request.auth.uid != userId
          && resource.data.role == "participant"
          && exists(roomPath(resource.data.roomId))
          && get(roomPath(resource.data.roomId)).data.ownerUid == request.auth.uid
        )
      ));
    }

    match /bingoRooms/{roomId} {
      // 초대 목록을 보여주기 위해 방 메타정보는 방장/초대된 사용자에게만 보입니다.
      allow get, list: if isAdmin() || (canReadBingo() && canSeeRoom(resource.data));

      // 방 생성과 방장용 membership 생성을 반드시 같은 트랜잭션에서 처리합니다.
      allow create: if canWriteBingo()
        && request.resource.data.keys().hasOnly([
          "name", "ownerUid", "ownerName", "size", "boardType", "alphabetMode", "participantUids", "createdAt", "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.size in [3, 4, 5, 6, 7, 8, 9, 10]
        && request.resource.data.get("boardType", "number") in ["number", "alphabet"]
        && request.resource.data.get("alphabetMode", "none") in ["none", "random", "custom"]
        && (
          (request.resource.data.get("boardType", "number") == "number"
            && request.resource.data.get("alphabetMode", "none") == "none")
          ||
          (request.resource.data.get("boardType", "number") == "alphabet"
            && request.resource.data.get("alphabetMode", "none") in ["random", "custom"])
        )
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() <= 20
        && !(request.auth.uid in request.resource.data.participantUids)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(membershipPath(request.auth.uid)).data.roomId == roomId
        && getAfter(membershipPath(request.auth.uid)).data.role == "owner";

      // 방장만 방 이름/참가자를 수정할 수 있습니다.
      allow update: if canWriteBingo()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.size == resource.data.size
        && request.resource.data.get("boardType", "number") == resource.data.get("boardType", "number")
        && request.resource.data.get("alphabetMode", "none") == resource.data.get("alphabetMode", "none")
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() <= 20
        && !(request.auth.uid in request.resource.data.participantUids)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "participantUids", "updatedAt"
        ]);

      // 관리자는 사용자 삭제 시 다른 방의 초대 기록에서 해당 사용자를 제거할 수 있습니다.
      allow update: if isAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.size == resource.data.size
        && request.resource.data.get("boardType", "number") == resource.data.get("boardType", "number")
        && request.resource.data.get("alphabetMode", "none") == resource.data.get("alphabetMode", "none")
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() <= 20
        && !(resource.data.ownerUid in request.resource.data.participantUids)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "participantUids", "updatedAt"
        ]);

      // 방 삭제는 방장 본인만 가능합니다. 권한이 나중에 읽기로 내려가도 방 정리는 가능하게 둡니다.
      allow delete: if isAdmin() || (isApproved() && resource.data.ownerUid == request.auth.uid);
    }

    match /bingoBoards/{roomId} {
      // 실제 체크 상태는 현재 그 방에 참가 중인 사람만 읽습니다.
      allow get: if canReadBingo()
        && activeInRoom(roomId)
        && exists(roomPath(roomId))
        && canSeeRoom(get(roomPath(roomId)).data);
      allow list: if false;

      // 방 생성 시 빈 빙고판도 같은 트랜잭션에서 함께 만듭니다.
      allow create: if canWriteBingo()
        && request.resource.data.keys().hasOnly(["checkedCells", "imagePath", "chickenCount", "cellValues", "updatedAt"])
        && request.resource.data.checkedCells is map
        && request.resource.data.checkedCells.size() == 0
        && request.resource.data.imagePath == ""
        && request.resource.data.get("chickenCount", 0) is int
        && request.resource.data.get("chickenCount", 0) == 0
        && request.resource.data.get("cellValues", []) is list
        && request.resource.data.get("cellValues", []).size() <= 100
        && (
          (getAfter(roomPath(roomId)).data.get("boardType", "number") == "number"
            && request.resource.data.get("cellValues", []).size() == 0)
          ||
          (getAfter(roomPath(roomId)).data.get("boardType", "number") == "alphabet"
            && request.resource.data.get("cellValues", []).size() ==
              getAfter(roomPath(roomId)).data.size * getAfter(roomPath(roomId)).data.size)
        )
        && request.resource.data.updatedAt == request.time
        && getAfter(roomPath(roomId)).data.ownerUid == request.auth.uid
        && getAfter(membershipPath(request.auth.uid)).data.roomId == roomId;

      // 현재 참가 중이며 쓰기 권한이 있는 사람만 체크 상태를 바꿀 수 있습니다.
      allow update: if canWriteBingo()
        && activeInRoom(roomId)
        && exists(roomPath(roomId))
        && canSeeRoom(get(roomPath(roomId)).data)
        && request.resource.data.checkedCells is map
        && request.resource.data.checkedCells.size() <= 100
        && request.resource.data.get("chickenCount", 0) is int
        && request.resource.data.get("chickenCount", 0) >= 0
        && request.resource.data.get("chickenCount", 0) <= 999
        && request.resource.data.get("cellValues", []) == resource.data.get("cellValues", [])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "checkedCells", "chickenCount", "updatedAt"
        ]);

      // 방장은 방 삭제 전에 빙고판 데이터를 지울 수 있습니다.
      allow delete: if isAdmin() || (isApproved()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid);
    }

    match /killSheet/{document=**} {
      allow read: if canReadKillSheet();
      allow write: if canWriteKillSheet();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
